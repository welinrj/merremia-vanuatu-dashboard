rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isEditor() {
      return isAuthenticated() &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      // Anyone can read user profiles (for collaboration features)
      allow read: if true;

      // Users can create their own profile during signup
      allow create: if isOwner(userId);

      // Users can update their own profile
      // Admins can update any profile
      allow update: if isOwner(userId) || isAdmin();

      // Only admins can delete user profiles
      allow delete: if isAdmin();
    }

    // Dataset metadata (public read, authenticated write)
    match /dataset_metadata/{datasetId} {
      // Public read access for all datasets
      allow read: if true;

      // Editors and admins can create, update, delete
      allow create, update: if isEditor();
      allow delete: if isEditor() || isAdmin();
    }

    // Full datasets (public read, authenticated write)
    match /datasets/{datasetId} {
      // Public read access
      allow read: if true;

      // Editors and admins can create, update, delete
      allow create, update: if isEditor();
      allow delete: if isEditor() || isAdmin();
    }

    // Field observations (for real-time dashboard)
    // Stored in Realtime Database, not Firestore
    // But we can keep metadata here
    match /field_observations_meta/{observationId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isEditor() || isAdmin();
    }

    // System configuration (admin only)
    match /system_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Activity logs (write-only for users, read for admins)
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Logs are immutable
    }

    // ─── NBSAP GIS Portal collections ────────────────────────
    // The portal uses passphrase-based auth (not Firebase Auth),
    // so these collections allow open read access but validate writes.
    // Data integrity is enforced at both the application and rules level.

    // NBSAP layers — layer metadata docs + GeoJSON chunk subcollections
    match /nbsap_layers/{layerId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAny(['metadata']);
      allow delete: if true;

      // GeoJSON chunks subcollection (800KB per chunk)
      match /chunks/{chunkId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasAny(['d']);
        allow delete: if true;
      }
    }

    // NBSAP metrics snapshots
    match /nbsap_metrics/{metricId} {
      allow read: if true;
      allow create, update: if request.resource.data.size() > 0;
      allow delete: if true;
    }

    // NBSAP audit log
    match /nbsap_audit/{auditId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false; // Audit entries are immutable
    }

    // NBSAP portal settings
    match /nbsap_settings/{settingId} {
      allow read: if true;
      allow create, update: if request.resource.data.size() > 0;
      allow delete: if true;
    }

    // NBSAP admin datasets — stored without target assignment
    // for reference data, baselines, or cross-target datasets
    match /nbsap_admin_datasets/{datasetId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAny(['metadata']);
      allow delete: if true;

      match /chunks/{chunkId} {
        allow read: if true;
        allow create, update: if request.resource.data.keys().hasAny(['d']);
        allow delete: if true;
      }
    }
  }
}
